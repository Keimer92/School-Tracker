{
  "compilerOptions": {
    "target": "ES2015",
    "useDefineForClassFields": true,
    "lib": ["ES2015", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.supabase.ts", "src/**/*.backup.ts", "src/**/*.old.ts", "src/lib/tursoClient.ts", "src/lib/tursoSyncService.ts", "src/lib/supabase.ts", "src/lib/syncService.supabase.ts", "src/lib/realtimeService.ts", "src/lib/realtimeService.supabase.ts", "src/svelte/SyncStatus.svelte"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
