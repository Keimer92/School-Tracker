{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senku App",
  "version": "0.1.0",
  "identifier": "com.keimer.senkuapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Senku App",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        {
          "host": "supabase",
          "scheme": "com.keimer.senkuapp"
        },
        {
          "host": "callback",
          "scheme": "appwrite-callback-69bcc5c3000d4847de99"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
