{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "file://*" }, { "url": "https://*" }]
    },
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**" }, { "path": "$TEMP/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$DOCUMENT/**" }]
    },
    "fs:allow-exists",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**" }, { "path": "$TEMP/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/**" }]
    },
    "fs:allow-desktop-write-recursive",
    "fs:allow-download-write-recursive",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$DOCUMENT/**" }]
    },
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    "allow-local-commands",
    "core:webview:allow-create-webview",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:default"
  ]
}
