# ============================================
# .gitignore para Rust/Tauri + Windows/Android
# ============================================

# --- Rust / Cargo (build artifacts, muy pesados) ---
src-tauri/target/

# --- Node.js ---
node_modules/

# --- Vite cache ---
node_modules/.vite

# --- Frontend build output ---
dist/
build/

# --- Android nativo (auto-generado por 'npx tauri android init') ---
# Ignorar src-tauri/gen/ excepto archivos Android custom
# NOTA: usar * en vez de / para que las negaciones funcionen
src-tauri/gen/*
src-tauri/gen/schemas/*
!src-tauri/gen/android/
src-tauri/gen/android/*
!src-tauri/gen/android/app/
src-tauri/gen/android/app/*
!src-tauri/gen/android/app/src/
src-tauri/gen/android/app/src/*
!src-tauri/gen/android/app/src/main/
src-tauri/gen/android/app/src/main/*
!src-tauri/gen/android/app/src/main/java/
src-tauri/gen/android/app/src/main/java/*
!src-tauri/gen/android/app/src/main/java/com/
src-tauri/gen/android/app/src/main/java/com/*
!src-tauri/gen/android/app/src/main/java/com/keimer/
src-tauri/gen/android/app/src/main/java/com/keimer/*
!src-tauri/gen/android/app/src/main/java/com/keimer/schooltracker/
src-tauri/gen/android/app/src/main/java/com/keimer/schooltracker/generated/*

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Variables de entorno (pueden contener keys) ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log

# --- Wrangler / Cloudflare local state ---
.wrangler/
cloudflare-sync/.wrangler/

schooltracker.key
