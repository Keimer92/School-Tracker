# ============================================
# .gitignore para Rust/Tauri + Windows/Android
# ============================================

# --- Rust / Cargo (build artifacts, muy pesados) ---
# OJO: antes solo se ignoraba `src-tauri/target/`, asi que el `target/` de la
# RAIZ (el del tauri-android-signer) se commiteo entero: 5125 blobs, ~1 GB de
# .rmeta/.rlib/.dll.lib de Windows. El patron `target/` de abajo cubre todos.
target/
**/target/

# --- Node.js ---
node_modules/

# --- Vite cache ---
node_modules/.vite

# --- Frontend build output ---
dist/
build/

# --- Android nativo (auto-generado por 'npx tauri android init') ---
# Ignorar src-tauri/gen/ excepto archivos Android custom (commiteados).
# Ver AGENTS.md → "Archivos Android custom en gen/"
src-tauri/gen/schemas/
# Auto-generado por Tauri (NO commitear):
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/src/main/java/com/keimer/gympro/generated/
src-tauri/gen/android/app/tauri.build.gradle.kts
src-tauri/gen/android/app/tauri.properties
src-tauri/gen/android/app/proguard-tauri.pro
src-tauri/gen/android/app/.editorconfig
src-tauri/gen/android/app/.gitignore
src-tauri/gen/android/app/src/main/assets/
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/gradlew
src-tauri/gen/android/gradlew.bat
src-tauri/gen/android/gradle/
src-tauri/gen/android/local.properties
src-tauri/gen/android/build/
src-tauri/gen/android/.gitignore
src-tauri/gen/android/.editorconfig
src-tauri/gen/android/.idea/
src-tauri/gen/android/build.gradle.kts
src-tauri/gen/android/settings.gradle
src-tauri/gen/android/gradle.properties
src-tauri/gen/android/buildSrc/
src-tauri/gen/android/app/src/main/res/drawable/
src-tauri/gen/android/app/src/main/res/drawable-v24/
src-tauri/gen/android/app/src/main/res/layout/
src-tauri/gen/android/app/src/main/res/mipmap-*/
src-tauri/gen/android/app/src/main/res/values/
src-tauri/gen/android/app/src/main/res/values-night/

# --- Datos personales: NUNCA en git ---
# Credenciales de Cloudflare (schoolKey + workerUrl). El archivo se guardaba
# commiteado; ahora queda fuera. Ver AGENTS.md → "Credenciales Cloudflare".
Credenciales.xlsx
*.xlsx

# Respaldos de la base de datos local: contienen los estudiantes reales
# (nombre, código, teléfono, email, asistencia y notas).
Bakups de base de datos/
*.db
*.db.backup_*
*.sqlite

# --- Basura de desarrollo local ---
# Salida de compilación mandada a un archivo por error (`npm i > 2`).
/src-tauri/2
src-tauri/cargo_check*.txt
src-tauri/cargo_check_out.txt
# Config personal de la extensión Code Runner (devUrl del emulador Android).
src-tauri/.code-runner-config.json
# Artefactos de Windows que se colaron en el repo.
*.pdb

# --- whatsapp-engine: node_modules copiado, se regenera con npm install ---
src-tauri/whatsapp-engine/

# --- Datos sensibles / logs ---
*.log
whatsapp.log.txt
KEIMER-LABS-*.txt

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Variables de entorno (pueden contener keys) ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log

# --- Wrangler / Cloudflare local state ---
.wrangler/
cloudflare-sync/.wrangler/

schooltracker.key
