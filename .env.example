# Google Drive Backup
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=tu_client_secret

# Worker de Cloudflare D1. Opcional: `cloudAuth.ts` tiene el mismo valor como
# fallback, pero ponerlo acá evita depender de ese default si algún día cambia.
VITE_D1_WORKER_URL=https://schooltracker-d1-sync.pedroluisnfc.workers.dev

# ─────────────────────────────────────────────────────────────
# En CI (.github/workflows/release.yaml) NO se usa este archivo.
#
# Vite INLINEA estas variables en el bundle al compilar, así que en el runner
# hay que pasarlas por secrets del repositorio o el APK/instalador publicados
# salen con el client_id de Google vacío y no funcionan ni el Sign-In ni Drive.
#
# Secrets a crear en el repo (Settings → Secrets and variables → Actions):
#   VITE_GOOGLE_CLIENT_ID
#   VITE_GOOGLE_CLIENT_SECRET
#   VITE_D1_WORKER_URL
#   KEYSTORE_PASSWORD     <- storePassword de keystore.properties
#   KEY_PASSWORD         <- keyPassword
#   KEY_ALIAS            <- keyAlias
# ─────────────────────────────────────────────────────────────